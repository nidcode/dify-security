# Dify 本体 (api / api_websocket / worker / worker_beat) のログ。全インスタンス分。
#   scripts/log-setup.sh dify --apply が @REPO_DIR@ を置換して /etc/logrotate.d/dify-app に配置する (root 所有必須)。
#   保持期間 (rotate = 日数) などは配置先のファイルを直接変更してよい (再実行しても上書きしない)。
#   copytruncate: アプリにファイルを開き直させずに済む (squid / nginx / Dify で共通の方式)。
@REPO_DIR@/dify/instances/*/logs/api/*.log
@REPO_DIR@/dify/instances/*/logs/api_websocket/*.log
@REPO_DIR@/dify/instances/*/logs/worker/*.log
@REPO_DIR@/dify/instances/*/logs/worker_beat/*.log
{
    daily
    rotate 90
    missingok
    notifempty
    compress
    delaycompress
    dateext
    copytruncate
}

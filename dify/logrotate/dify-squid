# Dify の squid (ssrf_proxy / agent_ssrf_proxy / model_egress_guard) のログ。全インスタンス分。
#   scripts/log-setup.sh dify --apply が @REPO_DIR@ を置換して /etc/logrotate.d/dify-squid に配置する (root 所有必須)。
#   保持期間 (rotate = 日数) などは配置先のファイルを直接変更してよい (再実行しても上書きしない)。
#   copytruncate: アプリにファイルを開き直させずに済む (squid / nginx / Dify で共通の方式)。
@REPO_DIR@/dify/instances/*/logs/ssrf_proxy/*.log
@REPO_DIR@/dify/instances/*/logs/agent_ssrf_proxy/*.log
@REPO_DIR@/dify/instances/*/logs/model_egress_guard/*.log
{
    daily
    rotate 90
    missingok
    notifempty
    compress
    delaycompress
    dateext
    copytruncate
}

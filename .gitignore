# シークレット
.env
*.bak

# Dify テンプレート本体 (dify/docker/) は追跡する。ただし:
#   - *.env はシークレット (dify/docker/.gitignore が *.env を除外・*.env.example は残す)
#   - 実行時データはテンプレでは生成されない設計だが、念のため既知の runtime dir を除外
dify/docker/.env
dify/docker/volumes/app/storage/
dify/docker/volumes/db/data/
dify/docker/volumes/redis/data/
dify/docker/volumes/weaviate/
dify/docker/volumes/plugin_daemon/

# Dify インスタンス = 公式 docker/ の複製 (.env / volumes データを含む生成物)
dify/instances/

# Gateway 生成物・機密
# ※ gitignore はインライン # コメントを解釈しない (行頭のみ)。パターンと同じ行に書くと無効化される。
# TLS 証明書 (wildcard)。.gitkeep のみ残す
gateway/certs/*
!gateway/certs/.gitkeep
# oauth2-proxy サービス群 (client secret を含む)
gateway/oauth2-proxies.gateway.yaml
# チーム別 server ブロック (生成物)
gateway/nginx/templates/team-*.conf.template
# デプロイ固有のローカル追加テンプレート (バレ→app リダイレクト等)
gateway/nginx/templates/local-*.conf.template
# WIF 用 Keycloak client secret (scripts/gateway-wif-client.sh の生成物)
gateway/wif/

# OS
.DS_Store

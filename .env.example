###############################################################################
# AIOP — 中央スタックの環境変数 (LiteLLM が参照)
#
#   このファイルは雛形です。`make bootstrap` (= scripts/gen-env.sh) を実行すると
#   シークレットが自動生成された .env が作られます。手動で作る場合は
#   `cp .env.example .env` して PROVIDER キー等を埋めてください。
#
#   重要: .env は機密です。git にコミットしないこと (.gitignore 済み)。
###############################################################################

# =============================================================================
# 1. LLM プロバイダ (LiteLLM の背後)
# =============================================================================
# Anthropic Claude — https://console.anthropic.com/ で取得
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Vertex AI (Gemini埋め込み) — APIキーではなく ADC を使用
#   ホストで: gcloud auth application-default login
#   ~/.config/gcloud がコンテナにマウントされ ADC で認証される (静的キー不要)
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=us-central1

# ローカル Ollama。Docker Desktop(mac/win)では host.docker.internal が host を指す。
# Linux では LiteLLM サービスに extra_hosts:host-gateway を付与済み。
# Ollama をコンテナ化したい場合は別途 compose に追加し、ここを http://ollama:11434 に。
OLLAMA_API_BASE=http://host.docker.internal:11434

# =============================================================================
# 2. LiteLLM ゲートウェイ (統制レイヤー)
# =============================================================================
# 管理マスターキー。これで /key, /team, /budget 等の管理APIと UI にアクセス。 (sk- で始める)
LITELLM_MASTER_KEY=sk-CHANGE-ME-master-key
# DB に保存するプロバイダキーを暗号化する鍵
LITELLM_SALT_KEY=CHANGE-ME-litellm-salt
# 管理 UI ( http://localhost:4000/ui ) のログイン
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=CHANGE-ME-litellm-ui-pass
# LiteLLM 用 Postgres のパスワード
LITELLM_DB_PASSWORD=CHANGE-ME-litellm-db-pass
# ホスト公開ポート
LITELLM_PORT=4000
# LiteLLM を公開するホストのインタフェース (セキュリティ)。
#   既定 172.17.0.1 = docker bridge gateway。ネイティブ Linux docker では
#   Dify コンテナ内の host.docker.internal がこの IP を指すため、ここにバインドすると
#   全 Dify から到達でき、かつ LAN には露出しない (172.17.0.0/16 はホスト内部網)。
#   ※ docker0 のサブネットを変更している場合はそのゲートウェイIPに合わせる
#     (確認: `docker network inspect bridge -f '{{(index .IPAM.Config 0).Gateway}}'`)。
#   ※ Docker Desktop / WSL2 backend を使う場合は 127.0.0.1 でも到達する。
LITELLM_HOST=172.17.0.1
